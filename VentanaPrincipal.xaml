<Window x:Class="ReceptorBluetooth.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receptor Bluetooth" Width="700" Height="660"
        MinWidth="580" MinHeight="600" Background="#F3F5F8"
        FontFamily="Segoe UI" FontSize="14" Foreground="#172333"
        Loaded="AlCargar" Closing="AlCerrar" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <TextBlock Text="Receptor Bluetooth" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="El audio de tu teléfono, en los audífonos de tu laptop." Margin="0,8,0,24" Foreground="#526174"/>
            <Border Background="White" CornerRadius="14" Padding="24">
                <StackPanel>
                    <TextBlock Text="TELÉFONO → LAPTOP → AUDÍFONOS" FontSize="12" FontWeight="SemiBold" Foreground="#526174"/>
                    <TextBlock x:Name="Estado" Text="Preparando Bluetooth…" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <TextBlock x:Name="Detalle" Text="" Foreground="#526174" Margin="0,0,0,20"/>
                    <TextBlock Text="Dispositivos disponibles" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox x:Name="ListaDispositivos" Height="130" DisplayMemberPath="Name"
                             SelectionChanged="AlSeleccionar" BorderBrush="#D6DEE8"/>
                    <TextBlock x:Name="AvisoLista" Text="Buscando teléfonos emparejados…" FontSize="12" Foreground="#526174" Margin="0,8,0,18"/>
                    <WrapPanel>
                        <Button x:Name="BotonConectar" Content="Conectar audio" Click="AlConectar" IsEnabled="False" Background="#175BCD" Foreground="White"/>
                        <Button x:Name="BotonDesconectar" Content="Desconectar" Click="AlDesconectar" IsEnabled="False"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="Para empezar" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10"/>
            <TextBlock Text="1. Empareja tu Android con esta laptop en los ajustes de Bluetooth.&#10;2. Conecta tus audífonos por cable y selecciónalos como salida de Windows.&#10;3. Elige tu teléfono aquí, conecta el audio y reproduce música en Android." Foreground="#526174" LineHeight="24"/>
            <WrapPanel Margin="0,18,0,0">
                <Button Content="Abrir Bluetooth" Click="AbrirBluetooth"/>
                <Button Content="Salida de audio" Click="AbrirAudio"/>
            </WrapPanel>
            <TextBlock Text="Mantén esta app abierta mientras escuchas. Se usa la salida de audio predeterminada de Windows." FontSize="12" Foreground="#526174" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
